{
  "name": "ispolandsafenow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 8787",
    "build": "astro check && astro build",
    "preview": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "worker:dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply ispolandsafenow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ispolandsafenow-db --remote",
    "map:convert": "node scripts/convert-map.mjs",
    "scheduler:deploy": "wrangler deploy --config scheduler/wrangler.jsonc",
    "scheduler:secret": "wrangler secret put TYPESAFE_AI_API_KEY --config scheduler/wrangler.jsonc",
    "scheduler:tail": "wrangler tail --config scheduler/wrangler.jsonc",
    "scheduler:trigger": "wrangler dev --config scheduler/wrangler.jsonc --test-scheduled"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
