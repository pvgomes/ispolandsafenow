---
import PolandFlagIcon from "./PolandFlagIcon.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/methodology", label: "Methodology" },
  { href: "/about", label: "About" },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-slate-900">
      <PolandFlagIcon class="h-5 w-7 shrink-0 rounded-sm" />
      Is Poland Safe Now?
    </a>
    <nav aria-label="Primary">
      <ul class="flex gap-4 text-sm font-medium text-slate-600">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-slate-900"
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
