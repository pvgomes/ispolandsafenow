---
import { displayTitle, originalTitleIfTranslated, type NewsItem } from "../domain/news-item";
import { formatShortDate } from "../domain/format-news-date";

export interface Props {
  headlines: NewsItem[];
}

const { headlines } = Astro.props;
---

{
  headlines.length === 0 ? (
    <p class="text-sm italic text-slate-500 dark:text-slate-400" data-testid="news-ticker-empty">
      Headlines will appear here once the news feed has been collected.
    </p>
  ) : (
    <div class="relative min-h-[1.75rem]" data-news-ticker data-testid="news-ticker">
      <ul class="list-none">
        {headlines.map((item, index) => (
          <li hidden={index !== 0} data-ticker-item class="ticker-item text-base text-slate-700 dark:text-slate-300">
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              title={originalTitleIfTranslated(item) ?? undefined}
              class="underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500 dark:decoration-slate-600 dark:hover:decoration-slate-400"
            >
              {displayTitle(item)}
            </a>
            <span class="ml-2 whitespace-nowrap text-sm text-slate-400 dark:text-slate-500">
              <time datetime={item.publishedAt}>{formatShortDate(item.publishedAt)}</time>
              {item.sourceName && <> · {item.sourceName}</>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  /* Each headline slides up and fades in when it becomes current. CSS
     only — the script just toggles `hidden`, the animation restarts on
     its own because the element re-enters the render tree. */
  @keyframes ticker-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .ticker-item:not([hidden]) {
    animation: ticker-in 0.45s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-item:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  // Auto-rotates the news ticker every 8s. Plain vanilla JS, not a
  // framework island — this is passive display, not interactive, so it
  // doesn't need hydration (see ARCHITECTURE.md: the map is the only
  // client-hydrated component on this page).
  const ROTATE_MS = 8000;

  function initTicker(ticker: HTMLElement) {
    const items = Array.from(ticker.querySelectorAll<HTMLElement>("[data-ticker-item]"));
    if (items.length <= 1) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let index = 0;
    let timer: number | undefined;

    function show(next: number) {
      items[index]?.setAttribute("hidden", "");
      index = next;
      items[index]?.removeAttribute("hidden");
    }

    function start() {
      timer = window.setInterval(() => show((index + 1) % items.length), ROTATE_MS);
    }
    function stop() {
      if (timer !== undefined) window.clearInterval(timer);
    }

    start();
    // Pause on hover/focus so a visitor can actually read and click a
    // headline before it rotates away.
    ticker.addEventListener("mouseenter", stop);
    ticker.addEventListener("mouseleave", start);
    ticker.addEventListener("focusin", stop);
    ticker.addEventListener("focusout", start);
  }

  document.querySelectorAll<HTMLElement>("[data-news-ticker]").forEach(initTicker);
</script>
