---
export interface Props {
  heading: string;
  headingId: string;
  note: string;
}
const { heading, headingId, note } = Astro.props;
---

<section class="rounded-xl border border-dashed border-slate-300 p-5 dark:border-slate-600" aria-labelledby={headingId}>
  <h2 id={headingId} class="text-base font-semibold text-slate-900 dark:text-slate-100">{heading}</h2>
  <p class="mt-2 text-sm italic text-slate-500 dark:text-slate-400">{note}</p>
</section>
