---
import type { FaqEntry } from "../domain/faq";

export interface Props {
  entries: readonly FaqEntry[];
  heading?: string;
  headingId?: string;
}

const { entries, heading = "Frequently asked questions", headingId = "faq-heading" } = Astro.props;
---

{
  entries.length > 0 && (
    <section aria-labelledby={headingId} data-testid="faq-section">
      <h2 id={headingId} class="text-xl font-semibold text-slate-900 dark:text-slate-100">
        {heading}
      </h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white dark:divide-slate-700 dark:border-slate-700 dark:bg-slate-800">
        {entries.map((entry, index) => (
          <details class="group p-4" open={index === 0}>
            <summary class="cursor-pointer list-none marker:content-none">
              <h3 class="flex items-start justify-between gap-3 text-base font-semibold text-slate-900 dark:text-slate-100">
                <span>{entry.question}</span>
                <span
                  class="mt-1 shrink-0 text-slate-400 transition-transform group-open:rotate-180 dark:text-slate-500"
                  aria-hidden="true"
                >
                  ▾
                </span>
              </h3>
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">{entry.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
