---
import { ALERT_LEVELS, ALERT_LEVEL_PRESENTATION } from "../domain/alert-level";
import type { NationalSummary } from "../domain/national-summary";

export interface Props {
  summary: NationalSummary;
  lastUpdated: string;
}

const { summary, lastUpdated } = Astro.props;
const presentation = ALERT_LEVEL_PRESENTATION[summary.headlineLevel];
const lastUpdatedDisplay = new Date(lastUpdated).toLocaleString("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});
---

<section
  class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"
  aria-labelledby="national-status-heading"
  data-testid="national-status-card"
>
  <h2 id="national-status-heading" class="text-base font-semibold text-slate-500 dark:text-slate-400">
    National situation summary
  </h2>
  <div class="mt-2 flex items-center gap-3">
    <span class={`h-4 w-4 rounded-full ${presentation.dotClass}`} aria-hidden="true"></span>
    <span class={`text-2xl font-bold ${presentation.colorClass}`}>{presentation.label}</span>
  </div>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{presentation.description}</p>

  <dl class="mt-4 grid grid-cols-2 gap-2 text-sm text-slate-600 sm:grid-cols-5 dark:text-slate-300">
    {
      ALERT_LEVELS.map((level) => (
        <div>
          <dt class={`font-medium ${ALERT_LEVEL_PRESENTATION[level].colorClass}`}>
            {ALERT_LEVEL_PRESENTATION[level].label}
          </dt>
          <dd>{summary.counts[level]} regions</dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-4 text-xs text-slate-400 dark:text-slate-500" data-testid="last-updated">
    Last updated: {lastUpdatedDisplay} UTC · Data freshness: AI-assisted classification (TypeSafe AI)
  </p>
</section>
