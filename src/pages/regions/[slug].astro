---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { ALERT_LEVEL_PRESENTATION } from "../../domain/alert-level";
import { RegionRepository } from "../../repositories/region-repository";
import { MAJOR_CITIES } from "../../data/cities";
import { capitalOfRegion, citiesForRegion, formatCityList } from "../../domain/city";
import { env } from "cloudflare:workers";

const { slug } = Astro.params;
const regionRepository = new RegionRepository(env.DB);
// findBySlug already returns the persisted status from the hourly
// scheduled job (scheduler/src/index.ts) — no live classification call.
const region = slug ? await regionRepository.findBySlug(slug) : null;

if (!region) {
  Astro.response.status = 404;
}

const presentation = region ? ALERT_LEVEL_PRESENTATION[region.currentStatus] : null;
const cities = region ? citiesForRegion(MAJOR_CITIES, region.slug) : [];
const capital = region ? capitalOfRegion(MAJOR_CITIES, region.slug) : undefined;
const cityNames = cities.map((city) => city.name);

const pageTitle = region
  ? `${region.namePl}${capital ? ` (${capital.name})` : ""} security status — Is Poland Safe Now?`
  : "Region not found — Is Poland Safe Now?";
const cityPhrase = cityNames.length > 0 ? `, home to ${cityNames.slice(0, 3).join(", ")}` : "";
const pageDescription =
  region && presentation
    ? `AI-assisted security-alert status for ${region.namePl} (${region.nameEn}), one of Poland's 16 voivodeships${cityPhrase}: ${presentation.label} — ${presentation.description}`
    : "This voivodeship could not be found.";

const placeJsonLd = region
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Place",
        name: region.namePl,
        alternateName: region.nameEn,
        containedInPlace: { "@type": "Country", name: "Poland" },
        containsPlace: cities.map((city) => ({ "@type": "City", name: city.name })),
        additionalProperty: {
          "@type": "PropertyValue",
          name: "AlertLevel",
          value: region.currentStatus,
        },
      },
    ]
  : [];
---

<BaseLayout title={pageTitle} description={pageDescription} path={`/regions/${slug ?? ""}`} structuredData={placeJsonLd}>
  <SiteHeader />
  {
    !region || !presentation ? (
      <main id="main-content" class="mx-auto max-w-3xl px-4 py-12">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">Region not found</h1>
        <p class="mt-2 text-slate-600 dark:text-slate-300">
          No voivodeship matches "{slug}". Return to the{" "}
          <a class="underline" href="/">
            homepage
          </a>
          .
        </p>
      </main>
    ) : (
      <>
        <main id="main-content" class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-8">
          <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">{region.namePl}</h1>
            <p class="text-slate-500 dark:text-slate-400">
              {region.nameEn} · Voivodeship code {region.code}
            </p>
            {cities.length > 0 && (
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-testid="region-cities">
                <span class="font-medium text-slate-700 dark:text-slate-200">Main cities: </span>
                {formatCityList(cities)}
              </p>
            )}
          </div>

          <section
            class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800"
            aria-labelledby="region-status-heading"
          >
            <h2 id="region-status-heading" class="text-base font-semibold text-slate-500 dark:text-slate-400">
              Current status
            </h2>
            <div class="mt-2 flex items-center gap-3">
              <span class={`h-4 w-4 rounded-full ${presentation.dotClass}`} aria-hidden="true" />
              <span class={`text-2xl font-bold ${presentation.colorClass}`}>{presentation.label}</span>
            </div>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{presentation.description}</p>
            <dl class="mt-3 space-y-1 text-sm text-slate-500 dark:text-slate-400">
              <div>
                <dt class="inline font-medium text-slate-700 dark:text-slate-300">Last classified: </dt>
                <dd class="inline">{region.lastClassifiedAt ?? "Not available"}</dd>
              </div>
              <div>
                <dt class="inline font-medium text-slate-700 dark:text-slate-300">Status expires: </dt>
                <dd class="inline">{region.statusExpiresAt ?? "Not available"}</dd>
              </div>
            </dl>
          </section>

          <p class="text-sm text-slate-500 dark:text-slate-400">
            <a class="underline underline-offset-2" href="/">
              &larr; Back to the full map
            </a>
          </p>
        </main>
      </>
    )
  }
  <SiteFooter />
</BaseLayout>
